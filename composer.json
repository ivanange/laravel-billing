{
    "name": "ivanange/laravel-billing",
    "description": "Billing for Laravel apps: payment gateway instances, flexible coverage periods for any billable model, offline payments with confirmation, and a Filament admin plugin.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "billing",
        "subscriptions",
        "payments",
        "offline-payments",
        "omnipay",
        "filament"
    ],
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "filament/filament": "^5.0",
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.27",
        "omnipay/common": "^3.5",
        "orchestra/testbench": "^10.0|^11.0",
        "paystackhq/omnipay-paystack": "^1.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "filament/filament": "Admin screens: gateway instances, plans, payments, record-payment and pay-link actions (^5.0)",
        "omnipay/common": "Required for every online gateway (Paystack, NotchPay, Hubtel) (^3.5)",
        "paystackhq/omnipay-paystack": "Paystack: cards and Ghana mobile money (^1.1)"
    },
    "autoload": {
        "psr-4": {
            "Ivanange\\Billing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ivanange\\Billing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ivanange\\Billing\\BillingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
